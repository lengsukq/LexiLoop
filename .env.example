APP_TIMEZONE=Asia/Shanghai
# PostgreSQL 连接串；应用以 pgsql 模式运行
# 本地/Neon 示例：  postgresql://user:pass@host:5432/dbname?sslmode=require
# Queen 内网示例：  postgresql://postgres:postgres@10.0.111.1:5432/lexiloop?sslmode=require
DATABASE_URL=
LEXILOOP_PASSWORD=
# 访问 /api/background/tick 的 Bearer 密钥（非 Vercel Cron 触发时要求，Docker 可选）
CRON_SECRET=
# Docker 进程内后台 tick 开关，默认 true；设为 false 则仅靠浏览器 KeepAlive 驱动
# BACKGROUND_DOCKER_TICK_ENABLED=true
