NODE_ENV=development
APP_TIMEZONE=Asia/Shanghai
# PostgreSQL 连接串；应用以 pgsql 模式运行
# 示例：postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=
# 测试专用数据库；留空则自动从 DATABASE_URL 派生 <库名>_test
TEST_DATABASE_URL=
DATABASE_PATH=./data/app.sqlite
BACKUP_DIR=./data/backups
ECDICT_DATABASE_PATH=./data/reference/ecdict.sqlite
BACKGROUND_ENGINE_ENABLED=true
BACKGROUND_ENGINE_ID=lexiloop-app-engine
BACKGROUND_CONCURRENCY=2
BACKGROUND_POLL_INTERVAL_MS=1000
WORKER_STALE_AFTER_MS=30000
DICTIONARY_API_ENABLED=true
MYMEMORY_ENABLED=true
ECDICT_ENABLED=false
YOUDO_API_ENABLED=true
LEXILOOP_PASSWORD=
