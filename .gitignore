# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ── 项目私有：绝不提交 ──
# 含 DATABASE_URL / LLM API Key 等凭据
.env
.env.*
!.env.example

# 本地工具与构建产物
.vercel/
.zcode/
.claude/
*.tsbuildinfo
test-results/

# ── Android 发布签名：本地与 CI 注入，绝不提交 ──
# android/key.properties 含 store/key 密码；*.jks 是固定发布密钥。
# 模板见 android/key.properties.example。
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Apple 签名材料（后续启用 Developer ID / 公证时使用）
*.p12
*.p8
*.mobileprovision
