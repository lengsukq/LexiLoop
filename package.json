{
  "name": "lexiloop",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.source.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:init:pgsql": "tsx scripts/init-pgsql.ts",
    "check": "yarn typecheck && yarn lint && yarn test && yarn build",
    "migrations:generate": "tsx scripts/generate-migration-sources.ts",
    "prebuild": "yarn migrations:generate"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.468.0",
    "node-edge-tts": "^1.2.10",
    "papaparse": "^5.5.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.5.1",
    "ts-fsrs": "^5.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.2.0",
    "next": "16.2.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
